+/// A private DELETE-capable ordinary file; no native reparse may be followed.
+pub(crate) fn rename_file(path: &Path) -> Result<Object, i32> {
+    open_with_options(
+        path,
+        windows_sys::Win32::Storage::FileSystem::DELETE,
+        0x0000_0040, // FILE_NON_DIRECTORY_FILE, without FILE_OPEN_REPARSE_POINT.
+    )
+}
+
 fn open_with_options(path: &Path, access: u32, options: u32) -> Result<Object, i32> {
     let wide = crate::path::wide_path(path)?;
     let mut name = Name(unsafe { std::mem::zeroed() });
