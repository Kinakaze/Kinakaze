+//! Rename an ordinary native file through operation-local inode capabilities.
+//! Pin the source and destination parent once instead of probing their names
+//! and then opening the source again. Complex paths retain the full walker.
+use super::object::Object;
+use std::{
+    ffi::OsString,
+    path::{Path, PathBuf},
+    sync::OnceLock,
+};
+
+fn ordinary(path: &str) -> bool {
+    !path.is_empty()
+        && !path.ends_with('/')
+        && !path.contains('\0')
+        && !path.split('/').any(|part| part == "." || part == "..")
+}
+
+pub(super) fn try_rename(from: &str, to: &str, flags: u32) -> Result<Option<()>, i32> {
+    static ENABLED: OnceLock<bool> = OnceLock::new();
+    if flags & !1 != 0
+        || !ordinary(from)
+        || !ordinary(to)
+        || !*ENABLED.get_or_init(|| {
+            std::env::var_os("KINAKAZE_NATIVE_RENAME").as_deref() != Some(std::ffi::OsStr::new("0"))
+        })
+        || !crate::user_namespace::capable(1, 1)
+        || !crate::user_namespace::capable(1, 3)
+        || crate::path::overlay_root().is_some()
+        || [from, to].iter().any(|path| {
+            crate::mount::api::tree_reference(path).is_some()
+                || crate::tmpfs::owns(path)
+                || crate::procfs::owns(path)
+        })
+    {
+        return Ok(None);
+    }
+    let Some(namespace) = crate::path::namespace_root_path()? else {
+        return Ok(None);
+    };
+    let absolute = |path: &str| {
+        if path.starts_with('/') {
+            path.to_owned()
+        } else {
+            format!("{}/{path}", super::getcwd())
+        }
+    };
+    let from = absolute(from);
+    let to = absolute(to);
+    let _deferred = crate::signal::defer_delivery();
+    let Some(prepared) =
+        PreparedRename::open(&crate::path::default_system_root(), &namespace, &from, &to)?
+    else {
+        return Ok(None);
+    };
+    let _source_writer = crate::mount::native::write_canonical(&canonical(&from))?;
+    let _target_writer = crate::mount::native::write_canonical(&canonical(&to))?;
+    prepared.apply(flags == 0)?;
+    Ok(Some(()))
+}
+
+fn canonical(path: &str) -> String {
+    format!(
+        "/{}",
+        path.split('/')
+            .filter(|p| !p.is_empty())
+            .collect::<Vec<_>>()
+            .join("/")
+    )
+}
+
+struct PreparedRename {
+    source: Object,
+    parent: Object,
+    name: OsString,
+}
+
+impl PreparedRename {
+    fn open(root: &Path, namespace: &str, from: &str, to: &str) -> Result<Option<Self>, i32> {
+        if !from.starts_with('/') || !to.starts_with('/') || !ordinary(from) || !ordinary(to) {
+            return Ok(None);
+        }
+        let native = |absolute: &str| -> Result<Option<PathBuf>, i32> {
+            let mut guest = namespace.trim_end_matches('/').to_owned();
+            let mut path = root.to_path_buf();
+            for part in namespace.split('/').filter(|part| !part.is_empty()) {
+                path.push(crate::path::escape_component(part).as_ref());
+            }
+            for part in absolute.split('/').filter(|part| !part.is_empty()) {
+                guest.push('/');
+                guest.push_str(part);
+                path.push(crate::path::escape_component(part).as_ref());
+            }
+            Ok((!crate::mount::has_attachment(&guest)?).then_some(path))
+        };
+        let (Some(from), Some(to)) = (native(from)?, native(to)?) else {
+            return Ok(None);
+        };
+        let source = match crate::mount::overlay::native_open::rename_file(&from) {
+            Ok(object) => object,
+            Err(_) => return Ok(None),
+        };
+        let parent = match crate::mount::overlay::native_open::directory(
+            to.parent().ok_or(crate::EINVAL)?,
+        ) {
+            Ok(object) => object,
+            Err(_) => return Ok(None),
+        };
+        Ok(Some(Self {
+            source,
+            parent,
+            name: to.file_name().ok_or(crate::EINVAL)?.to_owned(),
+        }))
+    }
+
+    fn apply(&self, replace: bool) -> Result<(), i32> {
+        // Both private opens are owned for the entire request; no unrelated I/O
+        // shares the source completion event or cancellation scope.
+        unsafe {
+            super::rename_host_handle_relative(
+                self.source.raw(),
+                self.parent.raw(),
+                &self.name,
+                replace,
+            )
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests;
